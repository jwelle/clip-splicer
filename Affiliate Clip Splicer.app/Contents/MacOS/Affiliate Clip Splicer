#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
LAUNCHER="$PROJECT_DIR/launch_app.command"

if [ ! -f "$LAUNCHER" ]; then
  osascript -e 'display dialog "launch_app.command could not be found next to Affiliate Clip Splicer.app." buttons {"OK"} default button "OK" with icon caution'
  exit 1
fi

chmod +x "$LAUNCHER" >/dev/null 2>&1 || true

osascript <<OSA
 tell application "Terminal"
   activate
   do script quoted form of "$LAUNCHER"
 end tell
OSA
